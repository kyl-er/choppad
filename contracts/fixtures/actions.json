    {"name": "CHOP-13 pad.set with bank on a kept pad changes its own params, not the shared pad", "actions": [{"type": "slice.keep", "bank": 2, "pad": 5, "src": "/media/_mega/m1/samples/0123456789abcdef.wav", "start": 0, "end": 1.5, "params": {"gainDb": -3}}, {"type": "pad.set", "pad": 5, "bank": 2, "params": {"pitch": 7, "gainDb": -9}}, {"type": "pad.set", "pad": 5, "bank": 0, "params": {"pitch": 1}}], "expect": {"project": {"overrides": {"2:5": {"kept": true, "src": "/media/_mega/m1/samples/0123456789abcdef.wav", "params": {"gainDb": -9, "pitch": 7}}}, "pads": [{"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"pitch": 1, "gainDb": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}]}}},
