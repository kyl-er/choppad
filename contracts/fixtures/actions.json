    {"name": "CHOP-13 pad.reset with bank resets a kept pad's params", "actions": [{"type": "slice.keep", "bank": 1, "pad": 2, "src": "/media/_mega/m1/samples/0123456789abcdef.wav", "start": 0, "end": 1.5, "params": {"gainDb": -5, "pitch": 3}}, {"type": "pad.set", "pad": 2, "params": {"gainDb": -1}}, {"type": "pad.reset", "pad": 2, "bank": 1}], "expect": {"project": {"overrides": {"1:2": {"kept": true, "params": {"gainDb": 0, "pitch": 0, "reverse": false}}}, "pads": [{"muteGroup": 0}, {"muteGroup": 0}, {"gainDb": -1}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}, {"muteGroup": 0}]}}},
