    {"name": "W3b an old project has no song key, and setMode pattern or an empty chain change nothing", "actions": [{"type": "song.setMode", "mode": "pattern"}, {"type": "song.setChain", "chain": []}, {"type": "song.setChain", "chain": [{"pattern": "p1", "repeats": 2}]}, {"type": "song.selectPattern", "id": "p1"}, {"type": "song.removePattern", "id": "p1"}, {"type": "song.renamePattern", "id": "p1", "name": "x"}], "unchanged": true},
    {"name": "W3b song.addPattern stashes the edited pattern as Pattern 1 and starts an empty Pattern 2 that is now being edited", "project": {"pattern": {"bars": 2, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}}, "actions": [{"type": "song.addPattern"}], "expect": {"project": {"pattern": {"bars": 2, "events": []}, "song": {"mode": "pattern", "current": "p2", "chain": [], "patterns": [{"id": "p1", "name": "Pattern 1", "bars": 2, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, {"id": "p2", "name": "Pattern 2", "bars": 2, "events": []}]}}}},
    {"name": "W3b song.addPattern takes a name and a length, and copy duplicates the edited pattern (hits past the new end are left out)", "project": {"pattern": {"bars": 2, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}, {"beat": 6, "pad": 2, "bank": 0, "vel": 1, "pass": 1}]}}, "actions": [{"type": "song.addPattern", "name": "  Fill  ", "bars": 1, "copy": true}], "expect": {"project": {"pattern": {"bars": 1, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, "song": {"current": "p2", "patterns": [{"id": "p1", "bars": 2}, {"id": "p2", "name": "Fill", "bars": 1, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}]}}}},
    {"name": "W3b edits of the pattern go into the current pattern, and selecting another pattern loads its hits", "project": {"pattern": {"bars": 2, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}}, "actions": [{"type": "song.addPattern"}, {"type": "pattern.addEvent", "event": {"beat": 2, "pad": 4, "bank": 0, "vel": 1, "pass": 1}}, {"type": "pattern.toggleStep", "pad": 7, "step": 3}, {"type": "pattern.setBars", "bars": 4, "beatsPerBar": 4}, {"type": "song.selectPattern", "id": "p1"}], "expect": {"project": {"pattern": {"bars": 2, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, "song": {"current": "p1", "patterns": [{"id": "p1", "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, {"id": "p2", "bars": 4, "events": [{"beat": 2, "pad": 4, "bank": 0, "vel": 1, "pass": 1}, {"beat": 0.75, "pad": 7, "bank": 0, "vel": 1, "pass": -1}]}]}}}},
    {"name": "W3b pattern.undo and pattern.clear follow into the song's pattern too", "actions": [{"type": "song.addPattern"}, {"type": "pattern.addEvent", "event": {"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}}, {"type": "pattern.addEvent", "event": {"beat": 2, "pad": 4, "bank": 0, "vel": 1, "pass": 2}}, {"type": "pattern.undo"}, {"type": "song.addPattern"}, {"type": "pattern.addEvent", "event": {"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}}, {"type": "pattern.clear"}], "expect": {"project": {"pattern": {"events": []}, "song": {"current": "p3", "patterns": [{"id": "p1", "events": []}, {"id": "p2", "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, {"id": "p3", "events": []}]}}}},
    {"name": "W3b song.selectPattern ignores an unknown id and the pattern that is already edited", "actions": [{"type": "song.addPattern"}, {"type": "song.selectPattern", "id": "p2"}, {"type": "song.selectPattern", "id": "nope"}, {"type": "song.selectPattern"}], "expect": {"project": {"song": {"current": "p2"}}}},
    {"name": "W3b song.renamePattern trims, and ignores an empty or too long name", "actions": [{"type": "song.addPattern"}, {"type": "song.renamePattern", "id": "p1", "name": " Verse "}, {"type": "song.renamePattern", "id": "p2", "name": ""}, {"type": "song.renamePattern", "id": "p2", "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}, {"type": "song.renamePattern", "id": "p9", "name": "nope"}], "expect": {"project": {"song": {"patterns": [{"id": "p1", "name": "Verse"}, {"id": "p2", "name": "Pattern 2"}]}}}},
    {"name": "W3b song.setChain keeps known patterns, clamps repeats and drops the rest", "actions": [{"type": "song.addPattern"}, {"type": "song.setChain", "chain": [{"pattern": "p1", "repeats": 2}, {"pattern": "p2"}, {"pattern": "p9", "repeats": 1}, {"pattern": "p1", "repeats": 500}, {"pattern": "p2", "repeats": 0}, {"pattern": "p1", "repeats": "x"}, {"pattern": "p2", "repeats": 2.6}, "p1", null]}], "expect": {"project": {"song": {"chain": [{"pattern": "p1", "repeats": 2}, {"pattern": "p2", "repeats": 1}, {"pattern": "p1", "repeats": 64}, {"pattern": "p2", "repeats": 1}, {"pattern": "p2", "repeats": 3}]}}}},
    {"name": "W3b song.setChain with the same chain is a no-op and a chain that is not a list is ignored", "actions": [{"type": "song.addPattern"}, {"type": "song.setChain", "chain": [{"pattern": "p1", "repeats": 1}]}], "expect": {"project": {"song": {"chain": [{"pattern": "p1", "repeats": 1}]}}}},
    {"name": "W3b song.setChain not a list", "actions": [{"type": "song.setChain", "chain": "p1"}, {"type": "song.setChain"}], "unchanged": true},
