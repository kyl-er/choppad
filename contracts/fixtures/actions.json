{
  "about": "Action reducer cases (contracts/README.md §8). Every implementation of the reducer (browser: components/ui/actions.js; server: W1) must pass all of them. `project` seeds the saved project, `actions` are applied in order, `expect` is matched against the resulting state: objects match on the listed keys only, arrays and scalars must be equal. `unchanged: true` means the actions must leave the state exactly as it started.",
  "chops": { "grid": "1/4", "bpm": 120, "beats_per_bar": 4, "banks": [[0], [1], [2]] },
  "cases": [
    { "name": "initial state fills defaults",
      "actions": [],
      "expect": { "bank": 0, "selected": 0,
        "project": { "overrides": {}, "pattern": { "bars": 2, "events": [] },
          "fx": { "tone": 0, "low": 0, "mid": 0, "high": 0, "filter": 0, "reverb": 0, "size": 0.5 } },
        "settings": { "mode": "oneshot", "choke": true, "fullLevel": true, "quant": "1/16", "swing": 0, "metronome": true, "repeat": false, "repeatRate": 0.25, "follow": true } } },
    { "name": "initial state keeps saved pads and fills missing keys",
      "project": { "pads": [{ "pitch": 3 }], "fx": { "reverb": 0.4 }, "pattern": { "bars": 4, "events": [{ "beat": 1, "pad": 2, "bank": 0, "vel": 1, "pass": 1 }] } },
      "actions": [{ "type": "pad.select", "pad": 0 }],
      "unchanged": true,
      "expect": { "project": { "pattern": { "bars": 4 }, "fx": { "reverb": 0.4, "size": 0.5 } } } },
    { "name": "pad.set merges known keys and ignores unknown ones",
      "actions": [{ "type": "pad.set", "pad": 3, "params": { "pitch": -2, "reverse": true, "bogus": 1 } }, { "type": "pad.select", "pad": 3 }],
      "expect": { "selected": 3 } },
    { "name": "pad.set out of range is ignored",
      "actions": [{ "type": "pad.set", "pad": 16, "params": { "pitch": 1 } }, { "type": "pad.select", "pad": -1 }],
      "unchanged": true },
    { "name": "slice.set then slice.clear",
      "actions": [{ "type": "slice.set", "bank": 1, "pad": 2, "start": 10.5, "end": 11.25 }, { "type": "slice.set", "bank": 0, "pad": 0, "start": 1, "end": 2 }, { "type": "slice.clear", "bank": 0, "pad": 0 }],
      "expect": { "project": { "overrides": { "1:2": { "start": 10.5, "end": 11.25 } } } } },
    { "name": "slice.set needs end after start",
      "actions": [{ "type": "slice.set", "bank": 0, "pad": 0, "start": 5, "end": 5 }, { "type": "slice.clear", "bank": 0, "pad": 9 }],
      "unchanged": true },
    { "name": "slice.setMany skips bad entries",
      "actions": [{ "type": "slice.setMany", "bank": 2, "slices": [{ "pad": 0, "start": 1, "end": 2 }, { "pad": 1, "start": 4, "end": 3 }, { "pad": 15, "start": 7, "end": 8 }] }],
      "expect": { "project": { "overrides": { "2:0": { "start": 1, "end": 2 }, "2:15": { "start": 7, "end": 8 } } } } },
    { "name": "fx.set merges",
      "actions": [{ "type": "fx.set", "params": { "tone": -0.35, "reverb": 0.18 } }, { "type": "fx.set", "params": { "size": 0.3 } }],
      "expect": { "project": { "fx": { "tone": -0.35, "reverb": 0.18, "size": 0.3, "low": 0 } } } },
    { "name": "pattern.toggleStep adds a drawn hit on the current bank, then removes it",
      "actions": [{ "type": "bank.set", "bank": 1 }, { "type": "pattern.toggleStep", "pad": 4, "step": 6 }, { "type": "pattern.toggleStep", "pad": 0, "step": 0, "bank": 0, "vel": 0.55 }, { "type": "pattern.toggleStep", "pad": 4, "step": 6 }],
      "expect": { "bank": 1, "project": { "pattern": { "bars": 2, "events": [{ "beat": 0, "pad": 0, "bank": 0, "vel": 0.55, "pass": -1 }] } } } },
    { "name": "pattern.undo removes the latest recorded take and keeps drawn hits",
      "actions": [
        { "type": "pattern.toggleStep", "pad": 1, "step": 2 },
        { "type": "pattern.addEvent", "event": { "beat": 0, "pad": 0, "bank": 0, "vel": 1, "pass": 1 } },
        { "type": "pattern.addEvent", "event": { "beat": 1, "pad": 2, "bank": 0, "vel": 0.7, "pass": 2 } },
        { "type": "pattern.addEvent", "event": { "beat": 3, "pad": 2, "bank": 0, "vel": 0.7, "pass": 2 } },
        { "type": "pattern.undo" }],
      "expect": { "project": { "pattern": { "events": [{ "beat": 0.5, "pad": 1, "bank": 0, "vel": 1, "pass": -1 }, { "beat": 0, "pad": 0, "bank": 0, "vel": 1, "pass": 1 }] } } } },
    { "name": "pattern.setBars drops hits past the new loop end",
      "project": { "pattern": { "bars": 2, "events": [{ "beat": 3.75, "pad": 0, "bank": 0, "vel": 1, "pass": 1 }, { "beat": 4, "pad": 1, "bank": 0, "vel": 1, "pass": 1 }] } },
      "actions": [{ "type": "pattern.setBars", "bars": 1, "beatsPerBar": 4 }],
      "expect": { "project": { "pattern": { "bars": 1, "events": [{ "beat": 3.75, "pad": 0, "bank": 0, "vel": 1, "pass": 1 }] } } } },
    { "name": "pattern.clear and pattern.load",
      "project": { "pattern": { "bars": 2, "events": [{ "beat": 0, "pad": 0, "bank": 0, "vel": 1, "pass": 1 }] } },
      "actions": [{ "type": "pattern.clear" }, { "type": "pattern.load", "pattern": { "bars": 4, "events": [{ "beat": 2, "pad": 5, "bank": 1, "vel": 1, "pass": -1 }] } }],
      "expect": { "project": { "pattern": { "bars": 4, "events": [{ "beat": 2, "pad": 5, "bank": 1, "vel": 1, "pass": -1 }] } } } },
    { "name": "bank.set clamps to the bank list",
      "actions": [{ "type": "bank.set", "bank": 99 }],
      "expect": { "bank": 2 } },
    { "name": "chops.replace resets the bank and keeps the project",
      "actions": [{ "type": "bank.set", "bank": 2 }, { "type": "pad.set", "pad": 0, "params": { "gainDb": -6 } },
        { "type": "chops.replace", "chops": { "grid": "1/8", "bpm": 120, "beats_per_bar": 4, "banks": [[0], [1]] } }],
      "expect": { "bank": 0, "chops": { "grid": "1/8" } } },
    { "name": "settings.set merges known keys",
      "actions": [{ "type": "settings.set", "params": { "quant": "1/8", "swing": 0.25, "nope": true } }],
      "expect": { "settings": { "quant": "1/8", "swing": 0.25, "metronome": true } } },
    { "name": "sections.set replaces the list",
      "actions": [{ "type": "sections.set", "sections": [{ "label": "intro", "letter": "A", "start_s": 0, "end_s": 8, "start_bar": 0, "end_bar": 4 }] }],
      "expect": { "sections": [{ "label": "intro", "letter": "A", "start_s": 0, "end_s": 8, "start_bar": 0, "end_bar": 4 }] } },
    { "name": "slice.stretch attaches a stretched rendering to a slice (a grid pad takes its chop's start and end)",
      "actions": [{ "type": "slice.set", "bank": 0, "pad": 2, "start": 1.5, "end": 2 },
        { "type": "slice.stretch", "bank": 0, "pad": 2, "stretch": { "ratio": 0.7129, "url": "/media/x/stretch/0123456789abcdef.wav" } }],
      "expect": { "project": { "overrides": { "0:2": { "start": 1.5, "end": 2, "stretch": { "ratio": 0.7129, "url": "/media/x/stretch/0123456789abcdef.wav" } } } } } },
    { "name": "slice.stretch keeps a custom slice and slice.set drops the stretch",
      "actions": [{ "type": "slice.set", "bank": 1, "pad": 0, "start": 10, "end": 12 },
        { "type": "slice.stretch", "bank": 1, "pad": 0, "stretch": { "ratio": 2, "url": "/media/x/stretch/aaaaaaaaaaaaaaaa.wav" } },
        { "type": "slice.set", "bank": 1, "pad": 0, "start": 10, "end": 13 }],
      "expect": { "project": { "overrides": { "1:0": { "start": 10, "end": 13 } } } } },
    { "name": "slice.stretch with null removes only the stretch",
      "project": { "overrides": { "0:4": { "start": 3, "end": 4, "stretch": { "ratio": 1.5, "url": "/media/x/stretch/bbbbbbbbbbbbbbbb.wav" } } } },
      "actions": [{ "type": "slice.stretch", "bank": 0, "pad": 4, "stretch": null }],
      "expect": { "project": { "overrides": { "0:4": { "start": 3, "end": 4 } } } } },
    { "name": "slice.stretch ignores bad input",
      "actions": [{ "type": "slice.stretch", "bank": 0, "pad": 0, "stretch": { "ratio": 0, "url": "/x.wav" } },
        { "type": "slice.stretch", "bank": 0, "pad": 0, "stretch": { "ratio": 1.2 } },
        { "type": "slice.stretch", "bank": 0, "pad": 99, "stretch": { "ratio": 1.2, "url": "/x.wav" } },
        { "type": "slice.stretch", "bank": 9, "pad": 0, "stretch": { "ratio": 1.2, "url": "/x.wav" } },
        { "type": "slice.stretch", "bank": 0, "pad": 0, "stretch": null }],
      "unchanged": true },
    { "name": "kit.load puts kit pads on a bank (other songs keep their id, the open song's do not)",
      "actions": [{ "type": "kit.load", "bank": 1, "song": "me", "pads": [
        { "song_id": "other", "start": 4, "end": 5, "params": { "gainDb": -3, "pitch": 2, "bogus": 1 } },
        null,
        { "song_id": "me", "start": 7, "end": 8 },
        { "song_id": "other", "start": 1, "end": 2, "stretch": { "ratio": 0.5, "url": "/media/other/stretch/cccccccccccccccc.wav" } },
        { "song_id": "other", "start": 3, "end": 3 }] }],
      "expect": { "project": {
        "overrides": { "1:0": { "start": 4, "end": 5, "song": "other" }, "1:2": { "start": 7, "end": 8 },
          "1:3": { "start": 1, "end": 2, "song": "other", "stretch": { "ratio": 0.5, "url": "/media/other/stretch/cccccccccccccccc.wav" } } } } } },
    { "name": "kit.load ignores a bad bank or pad list",
      "actions": [{ "type": "kit.load", "bank": -1, "pads": [] }, { "type": "kit.load", "bank": 0 }],
      "expect": { "project": { "overrides": {} } } },
    { "name": "unknown action is ignored",
      "actions": [{ "type": "nope" }, {}],
      "unchanged": true },
    { "name": "W3b tempo.set sets the project tempo, then clears it back to the song's own",
      "actions": [{ "type": "tempo.set", "bpm": 92 }],
      "expect": { "project": { "tempo": { "bpm": 92, "follow": true } } } },
    { "name": "W3b tempo.set with bpm null keeps the key and means the song's own tempo",
      "project": { "tempo": { "bpm": 120, "follow": false } },
      "actions": [{ "type": "tempo.set", "bpm": null }],
      "expect": { "project": { "tempo": { "bpm": null, "follow": false } } } },
    { "name": "W3b tempo.set without bpm only changes follow",
      "actions": [{ "type": "tempo.set", "bpm": 100 }, { "type": "tempo.set", "follow": false }],
      "expect": { "project": { "tempo": { "bpm": 100, "follow": false } } } },
    { "name": "W3b tempo.set ignores out-of-range and non-numeric tempos, and no-ops leave the state alone",
      "actions": [{ "type": "tempo.set", "bpm": 5 }, { "type": "tempo.set", "bpm": 1000 }, { "type": "tempo.set", "bpm": "fast" },
        { "type": "tempo.set", "bpm": null }, { "type": "tempo.set", "follow": true }],
      "unchanged": true },
    { "name": "W3b an old project has no tempo key and a saved tempo loads",
      "project": { "tempo": { "bpm": 88.5 } },
      "actions": [{ "type": "pad.select", "pad": 0 }],
      "unchanged": true,
      "expect": { "project": { "tempo": { "bpm": 88.5, "follow": true } } } },
    { "name": "W3b slice.stretch keeps `fit` (the project tempo a rendering was made for) and drops a bad one",
      "actions": [{ "type": "slice.set", "bank": 0, "pad": 1, "start": 2, "end": 3 },
        { "type": "slice.stretch", "bank": 0, "pad": 1, "stretch": { "ratio": 1.25, "url": "/media/x/stretch/dddddddddddddddd.wav", "fit": 80.8 } },
        { "type": "slice.set", "bank": 0, "pad": 2, "start": 2, "end": 3 },
        { "type": "slice.stretch", "bank": 0, "pad": 2, "stretch": { "ratio": 1.1, "url": "/media/x/stretch/eeeeeeeeeeeeeeee.wav", "fit": -3 } }],
      "expect": { "project": { "overrides": {
        "0:1": { "start": 2, "end": 3, "stretch": { "ratio": 1.25, "url": "/media/x/stretch/dddddddddddddddd.wav", "fit": 80.8 } },
        "0:2": { "start": 2, "end": 3, "stretch": { "ratio": 1.1, "url": "/media/x/stretch/eeeeeeeeeeeeeeee.wav" } } } } } },
    { "name": "W3b kit.load carries a stretch's `fit`",
      "actions": [{ "type": "kit.load", "bank": 0, "song": "me", "pads": [
        { "song_id": "me", "start": 1, "end": 2, "stretch": { "ratio": 0.9, "url": "/media/me/stretch/ffffffffffffffff.wav", "fit": 112 } }] }],
      "expect": { "project": { "overrides": { "0:0": { "start": 1, "end": 2, "stretch": { "ratio": 0.9, "url": "/media/me/stretch/ffffffffffffffff.wav", "fit": 112 } } } } } },
    { "name": "W3b a pad starts with ADSR defaults that keep today's sound and the filter off",
      "actions": [],
      "expect": { "project": { "pads": [{ "attack": 0.0025, "decay": 0, "sustain": 1, "release": 0.003, "filter": { "type": "off", "cutoff": 8000, "q": 0.7 } }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }] } } },
    { "name": "W3b pad.set takes decay, sustain and a filter; a partial filter merges onto the pad's filter",
      "actions": [{ "type": "pad.set", "pad": 2, "params": { "decay": 0.3, "sustain": 0.4, "filter": { "type": "lp", "cutoff": 1200, "q": 3 } } },
        { "type": "pad.set", "pad": 2, "params": { "filter": { "cutoff": 900 } } }],
      "expect": { "project": { "pads": [{ "decay": 0 }, { "decay": 0 }, { "decay": 0.3, "sustain": 0.4, "filter": { "type": "lp", "cutoff": 900, "q": 3 } }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }] } } },
    { "name": "W3b pad.set clamps decay, sustain, cutoff and q",
      "actions": [{ "type": "pad.set", "pad": 0, "params": { "decay": 99, "sustain": 7, "filter": { "type": "hp", "cutoff": 5, "q": 500 } } },
        { "type": "pad.set", "pad": 1, "params": { "decay": -2, "sustain": -1, "filter": { "cutoff": 99999, "q": 0 } } }],
      "expect": { "project": { "pads": [{ "decay": 10, "sustain": 1, "filter": { "type": "hp", "cutoff": 20, "q": 24 } }, { "decay": 0, "sustain": 0, "filter": { "type": "off", "cutoff": 20000, "q": 0.1 } }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }] } } },
    { "name": "W3b pad.set ignores a bad filter, a bad filter type and non-numeric envelope values",
      "actions": [{ "type": "pad.set", "pad": 0, "params": { "decay": "slow", "sustain": null, "filter": "lp" } },
        { "type": "pad.set", "pad": 0, "params": { "filter": { "type": "notch", "cutoff": "high", "q": true } } }],
      "unchanged": true },
    { "name": "W3b pad.reset and kit.load handle the new pad params, saved pads without them load with defaults",
      "project": { "pads": [{ "pitch": 3 }, { "filter": { "type": "bp", "cutoff": 2000 }, "sustain": 0.5 }] },
      "actions": [{ "type": "kit.load", "bank": 0, "song": "me", "pads": [null, null,
          { "song_id": "me", "start": 1, "end": 2, "params": { "decay": 0.2, "filter": { "type": "lp", "cutoff": 500, "q": 2 } } }] },
        { "type": "pad.reset", "pad": 1 }],
      "expect": { "project": { "pads": [{ "pitch": 3, "sustain": 1, "filter": { "type": "off" } }, { "sustain": 1, "filter": { "type": "off", "cutoff": 8000, "q": 0.7 } }, { "decay": 0.2, "filter": { "type": "lp", "cutoff": 500, "q": 2 } }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }, { "gainDb": 0 }] } } },
    {"name": "W3b a pad starts with no mute group; pad.set takes a group 0..8", "actions": [{"type": "pad.set", "pad": 1, "params": {"muteGroup": 3}}, {"type": "pad.set", "pad": 2, "params": {"muteGroup": 8}}], "expect": {"project": {"pads": [{"muteGroup": 0}, {"muteGroup": 3}, {"muteGroup": 8}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}]}}},
    {"name": "W3b pad.set ignores a mute group out of range or not a whole number", "actions": [{"type": "pad.set", "pad": 0, "params": {"muteGroup": 9}}, {"type": "pad.set", "pad": 0, "params": {"muteGroup": -1}}, {"type": "pad.set", "pad": 0, "params": {"muteGroup": 1.5}}, {"type": "pad.set", "pad": 0, "params": {"muteGroup": "2"}}, {"type": "pad.set", "pad": 0, "params": {"muteGroup": true}}], "unchanged": true},
    {"name": "W3b copyToAll and kit.load carry the mute group, pad.reset clears it", "actions": [{"type": "pad.set", "pad": 0, "params": {"muteGroup": 2}}, {"type": "pad.copyToAll", "pad": 0}, {"type": "kit.load", "bank": 0, "song": "me", "pads": [null, {"song_id": "me", "start": 1, "end": 2, "params": {"muteGroup": 5}}]}, {"type": "pad.reset", "pad": 2}], "expect": {"project": {"pads": [{"muteGroup": 2}, {"muteGroup": 5}, {"muteGroup": 0}, {"muteGroup": 2}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}, {"gainDb": 0}]}}},
    {"name": "W3b settings.set takes 16 levels (a source pad and a mode), null turns it off, nothing else is accepted", "actions": [{"type": "settings.set", "params": {"sixteen": {"pad": 3, "mode": "pitch"}}}], "expect": {"settings": {"sixteen": {"pad": 3, "mode": "pitch"}, "mode": "oneshot"}}},
    {"name": "W3b settings.set sixteen null goes back to off", "actions": [{"type": "settings.set", "params": {"sixteen": {"pad": 0, "mode": "velocity"}}}, {"type": "settings.set", "params": {"sixteen": null}}], "expect": {"settings": {"sixteen": null}}},
    {"name": "W3b settings.set ignores a bad 16 levels value", "actions": [{"type": "settings.set", "params": {"sixteen": {"pad": 16, "mode": "pitch"}}}, {"type": "settings.set", "params": {"sixteen": {"pad": 2, "mode": "chaos"}}}, {"type": "settings.set", "params": {"sixteen": "velocity"}}, {"type": "settings.set", "params": {"sixteen": {"mode": "pitch"}}}], "unchanged": true},
    {"name": "W3b pattern.toggleStep can carry a pitch offset and a cutoff, and removing it works as before", "actions": [{"type": "pattern.toggleStep", "pad": 2, "step": 4, "bank": 0, "vel": 0.5, "pitch": -3, "cutoff": 1200}, {"type": "pattern.toggleStep", "pad": 5, "step": 0, "bank": 0}, {"type": "pattern.toggleStep", "pad": 5, "step": 1, "bank": 0, "pitch": "x"}], "expect": {"project": {"pattern": {"events": [{"beat": 1, "pad": 2, "bank": 0, "vel": 0.5, "pass": -1, "pitch": -3, "cutoff": 1200}, {"beat": 0, "pad": 5, "bank": 0, "vel": 1, "pass": -1}, {"beat": 0.25, "pad": 5, "bank": 0, "vel": 1, "pass": -1}]}}}},
    {"name": "W3b toggling a step with a pitch removes it again", "actions": [{"type": "pattern.toggleStep", "pad": 2, "step": 4, "pitch": 5}, {"type": "pattern.toggleStep", "pad": 2, "step": 4}], "expect": {"project": {"pattern": {"events": []}}}},
    {"name": "W3b recorded 16-level hits keep pitch and cutoff and undo takes the whole recording pass", "actions": [{"type": "pattern.toggleStep", "pad": 0, "step": 0}, {"type": "pattern.addEvent", "event": {"beat": 0.5, "pad": 7, "bank": 0, "vel": 1, "pass": 1, "pitch": 4}}, {"type": "pattern.addEvent", "event": {"beat": 1, "pad": 7, "bank": 0, "vel": 1, "pass": 1, "cutoff": 900}}, {"type": "pattern.addEvent", "event": {"beat": 1.5, "pad": 7, "bank": 0, "vel": 0.25, "pass": 2}}, {"type": "pattern.undo"}], "expect": {"project": {"pattern": {"events": [{"beat": 0, "pad": 0, "bank": 0, "vel": 1, "pass": -1}, {"beat": 0.5, "pad": 7, "bank": 0, "vel": 1, "pass": 1, "pitch": 4}, {"beat": 1, "pad": 7, "bank": 0, "vel": 1, "pass": 1, "cutoff": 900}]}}}},
    {"name": "W3b slice.src puts a resample on a pad as an override with its own start and end", "actions": [{"type": "slice.src", "bank": 1, "pad": 3, "src": "/media/me/resample/0123456789abcdef.wav", "start": 0, "end": 4.5}], "expect": {"project": {"overrides": {"1:3": {"start": 0, "end": 4.5, "src": "/media/me/resample/0123456789abcdef.wav"}}}}},
    {"name": "W3b slice.src replaces a custom slice and slice.src null removes the resample again", "actions": [{"type": "slice.set", "bank": 0, "pad": 0, "start": 1, "end": 2}, {"type": "slice.src", "bank": 0, "pad": 0, "src": "/media/me/resample/0123456789abcdef.wav", "start": 0, "end": 2}, {"type": "slice.set", "bank": 0, "pad": 1, "start": 5, "end": 6}, {"type": "slice.src", "bank": 0, "pad": 1, "src": null}], "expect": {"project": {"overrides": {"0:0": {"start": 0, "end": 2, "src": "/media/me/resample/0123456789abcdef.wav"}, "0:1": {"start": 5, "end": 6}}}}},
    {"name": "W3b slice.src ignores a url that is not a resample file and bad times", "actions": [{"type": "slice.src", "bank": 0, "pad": 0, "src": "/media/me/stretch/0123456789abcdef.wav", "start": 0, "end": 1}, {"type": "slice.src", "bank": 0, "pad": 0, "src": "/x.wav", "start": 0, "end": 1}, {"type": "slice.src", "bank": 0, "pad": 0, "src": "/media/me/resample/0123456789abcdef.wav", "start": 2, "end": 1}, {"type": "slice.src", "bank": 0, "pad": 0, "src": "/media/me/resample/0123456789abcdef.wav", "start": -1, "end": 1}, {"type": "slice.src", "bank": 0, "pad": 16, "src": "/media/me/resample/0123456789abcdef.wav", "start": 0, "end": 1}, {"type": "slice.src", "bank": -1, "pad": 0, "src": "/media/me/resample/0123456789abcdef.wav", "start": 0, "end": 1}, {"type": "slice.src", "bank": 0, "pad": 0, "src": null}], "unchanged": true},
    {"name": "W3b slice.stretch does not apply to a resample pad", "actions": [{"type": "slice.src", "bank": 0, "pad": 2, "src": "/media/me/resample/0123456789abcdef.wav", "start": 0, "end": 3}, {"type": "slice.stretch", "bank": 0, "pad": 2, "stretch": {"ratio": 1.5, "url": "/media/me/stretch/aaaaaaaaaaaaaaaa.wav"}}], "expect": {"project": {"overrides": {"0:2": {"start": 0, "end": 3, "src": "/media/me/resample/0123456789abcdef.wav"}}}}},
    {"name": "W3b slice.stem plays the pad's slice from a stem and keeps its start and end", "actions": [{"type": "slice.set", "bank": 0, "pad": 4, "start": 2, "end": 2.5}, {"type": "slice.stem", "bank": 0, "pad": 4, "stem": "drums"}, {"type": "slice.set", "bank": 0, "pad": 5, "start": 3, "end": 4}, {"type": "slice.stem", "bank": 0, "pad": 5, "stem": "bass"}], "expect": {"project": {"overrides": {"0:4": {"start": 2, "end": 2.5, "stem": "drums"}, "0:5": {"start": 3, "end": 4, "stem": "bass"}}}}},
    {"name": "W3b slice.stem drops a stretch made from the old source, and null goes back to the full mix", "project": {"overrides": {"0:0": {"start": 1, "end": 2, "stretch": {"ratio": 1.2, "url": "/media/me/stretch/bbbbbbbbbbbbbbbb.wav", "fit": 90}}}}, "actions": [{"type": "slice.stem", "bank": 0, "pad": 0, "stem": "vocals"}, {"type": "slice.set", "bank": 0, "pad": 1, "start": 8, "end": 9}, {"type": "slice.stem", "bank": 0, "pad": 1, "stem": "other"}, {"type": "slice.stem", "bank": 0, "pad": 1, "stem": null}], "expect": {"project": {"overrides": {"0:0": {"start": 1, "end": 2, "stem": "vocals"}, "0:1": {"start": 8, "end": 9}}}}},
    {"name": "W3b slice.stem ignores an unknown stem, a resample pad, a repeat and an empty pad", "actions": [{"type": "slice.stem", "bank": 0, "pad": 0, "stem": "guitar"}, {"type": "slice.src", "bank": 0, "pad": 1, "src": "/media/me/resample/0123456789abcdef.wav", "start": 0, "end": 1}, {"type": "slice.stem", "bank": 0, "pad": 1, "stem": "drums"}, {"type": "slice.stem", "bank": 9, "pad": 0, "stem": "drums"}, {"type": "slice.stem", "bank": 0, "pad": 3, "stem": null}], "expect": {"project": {"overrides": {"0:1": {"start": 0, "end": 1, "src": "/media/me/resample/0123456789abcdef.wav"}}}}},
