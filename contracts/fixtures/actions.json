    {"name": "CHOP-13 slice.keep makes a kept override with its params and provenance", "actions": [{"type": "slice.keep", "bank": 0, "pad": 3, "src": "/media/_mega/m1/samples/0123456789abcdef.wav", "start": 0, "end": 1.5, "params": {"gainDb": -4, "pitch": 2, "filter": {"type": "lp", "cutoff": 900}}, "from": {"song": "a", "start": 2, "end": 3.5}}], "expect": {"project": {"overrides": {"0:3": {"start": 0, "end": 1.5, "src": "/media/_mega/m1/samples/0123456789abcdef.wav", "kept": true, "params": {"gainDb": -4, "pitch": 2, "reverse": false, "muteGroup": 0, "filter": {"type": "lp", "cutoff": 900, "q": 0.7}}, "from": {"song": "a", "start": 2, "end": 3.5}}}}}},
