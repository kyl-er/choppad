    {"name": "W3b new pattern ids never reuse a removed one", "actions": [{"type": "song.addPattern"}, {"type": "song.addPattern"}, {"type": "song.removePattern", "id": "p2"}, {"type": "song.addPattern"}], "expect": {"project": {"song": {"current": "p4", "patterns": [{"id": "p1"}, {"id": "p3"}, {"id": "p4"}]}}}},
    {"name": "W3b a saved song loads with the edited pattern winning over its copy, and bad entries are cleaned", "project": {"pattern": {"bars": 3, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, "song": {"mode": "song", "current": "a", "patterns": [{"id": "a", "name": "A", "bars": 1, "events": []}, {"id": "a", "name": "dup"}, {"id": "b c", "name": "bad id"}, {"id": "b", "bars": 0.5, "events": [{"beat": 1}, {"beat": 2, "pad": 4, "bank": 0, "vel": 1, "pass": 1}]}], "chain": [{"pattern": "a", "repeats": 2}, {"pattern": "zzz"}, {"pattern": "b"}]}}, "actions": [], "expect": {"project": {"song": {"mode": "song", "current": "a", "chain": [{"pattern": "a", "repeats": 2}, {"pattern": "b", "repeats": 1}], "patterns": [{"id": "a", "name": "A", "bars": 3, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, {"id": "b", "name": "Pattern 2", "bars": 2, "events": [{"beat": 2, "pad": 4, "bank": 0, "vel": 1, "pass": 1}]}]}}}},
