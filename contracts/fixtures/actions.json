    {"name": "W3b song.removePattern leaves the chain, and removing the edited pattern selects the first one that is left", "project": {"pattern": {"bars": 2, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}}, "actions": [{"type": "song.addPattern"}, {"type": "song.addPattern"}, {"type": "pattern.addEvent", "event": {"beat": 2, "pad": 4, "bank": 0, "vel": 1, "pass": 1}}, {"type": "song.setChain", "chain": [{"pattern": "p1", "repeats": 1}, {"pattern": "p2", "repeats": 2}, {"pattern": "p3", "repeats": 1}]}, {"type": "song.removePattern", "id": "p3"}, {"type": "song.removePattern", "id": "p9"}], "expect": {"project": {"pattern": {"bars": 2, "events": [{"beat": 0, "pad": 1, "bank": 0, "vel": 1, "pass": 1}]}, "song": {"current": "p1", "chain": [{"pattern": "p1", "repeats": 1}, {"pattern": "p2", "repeats": 2}], "patterns": [{"id": "p1"}, {"id": "p2"}]}}}},
