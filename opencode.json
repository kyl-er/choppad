{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "external_directory": {
      "~/.claude/skills/**": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push *": "deny",
      "sudo *": "deny",
      "herdr server stop*": "deny"
    }
  }
}
